# Platform
NODE_ENV=development
APP_NAME=whatsapp-saas-platform
APP_PORT=3000
FRONTEND_PORT=4200
API_PORT=3001
WORKER_PORT=3002
SCHEDULER_PORT=3003

# PostgreSQL
POSTGRES_DB=whatsapp_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=postgresql://postgres:Vinayak%403110@localhost:5432/whatsapp_platform
DATABASE_POOL_MAX=20

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=wa-bot-secret-2026-very-long-random-key
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=whatsapp-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# WhatsApp
WHATSAPP_PROVIDER=webjs
WHATSAPP_SESSION_ENCRYPTION_KEY=replace-with-a-managed-encryption-key
WHATSAPP_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# App Security
CORS_ORIGIN=http://localhost:4200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Observability
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
